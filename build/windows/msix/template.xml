<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sessionflow"
        Arguments=""
        InstallLocation="C:\Program Files\Cesar Menegatti\SessionFlow">
    </Installer>
    <PackageInformation
        PackageName="SessionFlow"
        PackageDisplayName="SessionFlow"
        PublisherName="CN=Cesar Menegatti"
        PublisherDisplayName="Cesar Menegatti"
        Version="0.1.0.0"
        PackageDescription="Gerenciador desktop de sessões de agentes de programação">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.cesarmenegatti.sessionflow"
                Description="Gerenciador desktop de sessões de agentes de programação"
                DisplayName="SessionFlow"
                ExecutableName="sessionflow"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SessionFlow</DisplayName>
            <PublisherDisplayName>Cesar Menegatti</PublisherDisplayName>
            <Description>Gerenciador desktop de sessões de agentes de programação</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sessionflow.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
